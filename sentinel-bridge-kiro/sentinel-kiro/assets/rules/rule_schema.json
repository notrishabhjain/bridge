{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelRuleFile",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "enabled", "priority", "phase", "match", "action"],
        "properties": {
          "id": { "type": "string" },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 0 },
          "phase": { "type": "string", "enum": ["PRE_AI", "POST_AI"] },
          "description": { "type": "string" },
          "match": {
            "type": "object",
            "properties": {
              "contains": {
                "type": "array",
                "items": { "type": "string" }
              },
              "confidenceBelow": { "type": "number", "minimum": 0, "maximum": 1 },
              "confidenceAbove": { "type": "number", "minimum": 0, "maximum": 1 },
              "taskConfidenceBelow": { "type": "number", "minimum": 0, "maximum": 1 },
              "source": { "type": "string" }
            }
          },
          "action": {
            "type": "string",
            "enum": ["IGNORE", "REJECT", "FLAG", "TRANSFORM", "PASS"]
          },
          "transform": {
            "type": "string"
          }
        }
      }
    }
  }
}
